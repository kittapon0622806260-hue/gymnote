{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "npm install --prefix client --include=optional && npm run build --prefix client && npm install --prefix server",
        "nixpacksPlan": {
            "phases": {
                "setup": {
                    "nixPkgs": [
                        "nodejs_20"
                    ]
                }
            }
        }
    },
    "deploy": {
        "startCommand": "node server/server.js",
        "restartPolicyType": "ON_FAILURE"
    }
}